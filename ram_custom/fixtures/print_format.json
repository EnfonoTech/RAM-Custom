[
 {
  "custom_format": 1,
  "default_print_language": null,
  "disabled": 0,
  "doc_type": "Quotation",
  "docstatus": 0,
  "doctype": "Print Format",
  "html": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Quotation</title>\n</head>\n\n<body>\n\n<div class=\"print-format\">\n\n<style>\n\n/* =========================================================\n   TOTALS\n========================================================= */\n\n.total-box {\n    margin-top: 2px;\n    color: #fff;\n    font-weight: bold;\n}\n\n.total-row {\n    display: flex;\n    justify-content: space-between;\n    padding: 6px 10px;\n    margin: 0;\n}\n\n\n/* Gradient colors */\n\n.total-subtotal,\n.total-vat {\n    background: linear-gradient(135deg, #b65f1e, #cf8333);\n}\n\n.total-grand {\n    background: linear-gradient(135deg, #e27d1a, #fea041);\n}\n\n.total-words {\n    background: linear-gradient(135deg, #b46a1f, #d88b34);\n}\n\n\n/* =========================================================\n   ALIGNMENT\n========================================================= */\n\n.text-right {\n    text-align: right;\n}\n\n.text-center {\n    text-align: center;\n}\n\n.textStart {\n    text-align: start;\n}\n\n.textEnd {\n    text-align: end;\n}\n\n.text-sm {\n    font-size: 12px;\n}\n\n.small-text {\n    font-size: 10px;\n}\n\n\n/* =========================================================\n   ITEM TABLE\n========================================================= */\n\n.item-table {\n    width: 100%;\n    border-collapse: collapse;\n}\n\n.item-table thead th {\n    position: relative;\n    color: #fff;\n    font-weight: bold;\n    padding: 8px 6px;\n    text-align: center;\n    border: 1px solid #000;\n    vertical-align: middle;\n    overflow: hidden;\n}\n\n\n/* Gradient groups */\n\n.item-table thead th.col-no,\n.item-table thead th.col-code,\n.item-table thead th.col-desc {\n    background: linear-gradient(135deg, #b46a1f, #d88b34);\n}\n\n.item-table thead th.col-unit,\n.item-table thead th.col-qty,\n.item-table thead th.col-price,\n.item-table thead th.col-subtotal,\n.item-table thead th.col-vat {\n    background: linear-gradient(135deg, #b65f1e, #cf8333);\n}\n\n.item-table thead th.col-total {\n    background: linear-gradient(135deg, #e27d1a, #fea041);\n}\n\n\n/* Diagonal cut */\n\n.item-table thead th:not(.col-total)::after {\n    content: \"\";\n    position: absolute;\n    top: 0;\n    right: -18px;\n    width: 0;\n    height: 0;\n    border-top: 100% solid transparent;\n    border-left: 18px solid rgba(255, 255, 255, 0.25);\n    pointer-events: none;\n}\n\n\n/* =========================================================\n   ARABIC / ENGLISH HEADER\n========================================================= */\n\n.item-table thead th .ar {\n    display: block;\n    font-size: 11px;\n    margin-bottom: 3px;\n    direction: rtl;\n}\n\n.item-table thead th .en {\n    display: block;\n    font-size: 12px;\n}\n\n\n/* =========================================================\n   BODY\n========================================================= */\n\nbody {\n    font-family: Arial, sans-serif;\n    margin: 0;\n    padding: 0;\n}\n\n\n/* =========================================================\n   HEADER / FOOTER\n========================================================= */\n\n.header {\n    position: fixed;\n    top: 0;\n    left: 0;\n    right: 0;\n}\n\n.footer {\n    position: fixed;\n    bottom: 0;\n    left: 0;\n    right: 0;\n}\n\n.main-wrapper {\n    width: 100%;\n    border-collapse: collapse;\n}\n\n\n/* Repeat header/footer space */\n\n.main-wrapper > thead {\n    display: table-header-group;\n}\n\n.main-wrapper > tfoot {\n    display: table-footer-group;\n}\n\n\n/* =========================================================\n   TITLES\n========================================================= */\n\n.arabic-title {\n    color: #32368d;\n    font-size: 26px;\n    margin-bottom: 2px;\n    border-bottom: 1px solid red;\n    display: inline-block;\n}\n\n.english-title {\n    color: #32368d;\n    margin-top: 0;\n    font-weight: 600;\n    font-size: 18px;\n}\n\n\n/* =========================================================\n   TABLES\n========================================================= */\n\ntable {\n    width: 100%;\n    border-collapse: collapse;\n    margin-bottom: 12px;\n}\n\nth,\ntd {\n    border: 1px solid #ddd;\n    padding: 2px 4px;\n    font-size: 12px;\n}\n\nth {\n    background: #f2f2f2;\n    color: #1e1565;\n    font-weight: bold;\n}\n\n\n/* =========================================================\n   HEADER / FOOTER SPACE\n========================================================= */\n\n.header-space {\n    height: 170px;\n}\n\n.footer-space {\n    height: 170px;\n}\n\n\n/* =========================================================\n   MAIN CONTENT\n========================================================= */\n\n.main-content {\n    padding: 0 10px;\n}\n\n.title {\n    text-align: center;\n    font-size: 18px;\n    color: #1e1565;\n    font-weight: bold;\n    margin-bottom: 15px;\n}\n\n\n/* =========================================================\n   DETAIL TABLE\n========================================================= */\n\n.detail {\n    margin-top: 10px;\n}\n\n.detail th,\n.detail td {\n    border: 1px solid #ddd;\n    padding: 1px;\n    text-align: left;\n    font-size: 12px;\n    line-height: 1em;\n    vertical-align: middle;\n}\n\n.detail th {\n    background-color: #f2f2f2;\n    color: #1e1565;\n    font-weight: bold;\n}\n\n\n/* =========================================================\n   FLEX\n========================================================= */\n\n.flex,\n.third {\n    display: flex;\n    flex-wrap: wrap;\n    width: 100%;\n}\n\n.flexbetween,\n.justifySpaceBetween {\n    display: flex;\n    justify-content: space-between;\n}\n\n.flexdown {\n    width: 50%;\n    display: flex;\n    flex-direction: column;\n    gap: 5px;\n}\n\n.flex {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-start;\n}\n\n\n/* =========================================================\n   OTHER\n========================================================= */\n\n.pink {\n    background-color: #f9f2f5;\n}\n\n.footer-bottom {\n    margin-top: 5px;\n}\n\n.signature-container {\n    margin-top: 30px;\n    margin-bottom: 10px;\n    page-break-inside: avoid;\n}\n\n\n/* =========================================================\n   PRINT\n========================================================= */\n\n@media print {\n\n    @page {\n        margin: 0.2in;\n    }\n\n    .page-header {\n        position: fixed;\n        top: 0;\n    }\n\n    body {\n        margin: 0;\n    }\n\n}\n\n.detail th {\n    background: #d88b34 !important;\n    color: #14181f !important;\n}\n\n</style>\n\n\n<!-- =========================================================\n     HEADER\n========================================================= -->\n\n<div class=\"header\">\n\n    {% if doc.company == \"Rukn Al Mashreq International Trading Company\" %}\n\n        <img src=\"/files/Almashriq_header.png\"\n             style=\"width:100%; height:auto; object-fit:cover;\">\n\n    {% elif doc.company == \"ABB\" %}\n\n        <img src=\"/files/LETTER HEAD.ABB.png\"\n             style=\"width:100%; height:auto; object-fit:cover;\">\n\n    {% elif doc.company == \"Voltbuilds\" %}\n\n        <img src=\"/files/voltbuilds head.png\"\n             style=\"width:100%; height:auto; object-fit:cover;\">\n\n    {% elif doc.company == \"JCB\" %}\n\n        <img src=\"/files/headerjcb1.png\"\n             style=\"width:100%; height:auto; object-fit:cover;\">\n\n    {% endif %}\n\n</div>\n\n\n<!-- =========================================================\n     MAIN WRAPPER\n========================================================= -->\n\n<table class=\"main-wrapper\" style=\"border:none;\">\n\n    <thead>\n\n        <tr>\n\n            <td style=\"padding:0 !important; border:none;\">\n\n                <div class=\"header-space\">&nbsp;</div>\n\n            </td>\n\n        </tr>\n\n    </thead>\n\n\n    <tbody>\n\n        <tr>\n\n            <td style=\"padding:0 !important; border:none;\">\n\n                <div class=\"main-content\">\n\n\n<!-- =========================================================\n     QUOTATION TITLE\n========================================================= -->\n\n<div style=\"\n    text-align:center;\n    font-weight:bold;\n    font-size:18px;\n    line-height:1.4;\n\">\n\n    QUOTATION <br> عرض سعر\n\n</div>\n\n\n<!-- =========================================================\n     CUSTOMER / QUOTATION DETAILS\n========================================================= -->\n\n<table style=\"\n    width:100%;\n    border-collapse:collapse;\n    font-size:13px;\n    margin-top:0px;\n\">\n\n<tr>\n\n\n    <!-- =====================================================\n         LEFT SIDE - CUSTOMER DETAILS\n    ====================================================== -->\n\n    <td style=\"\n        width:55%;\n        vertical-align:top;\n        padding:5px;\n    \">\n\n        <strong>To / <span dir=\"rtl\">إلى</span>:</strong><br>\n\n        {{ doc.customer_name }}<br>\n\n        {% set customer_id = doc.party_name if doc.quotation_to == \"Customer\" else \"\" %}\n        {% set customer_name_ar = frappe.db.get_value(\"Customer\", customer_id, \"custom_customer_name_arabic\") if customer_id else \"\" %}\n        {% if customer_name_ar %}\n            <span dir=\"rtl\">{{ customer_name_ar }}</span><br>\n        {% endif %}\n\n        {% if doc.customer_address %}\n\n            {% set addr = frappe.get_doc(\n                \"Address\",\n                doc.customer_address\n            ) %}\n\n            {{ addr.address_line1 or \"\" }}<br>\n            {{ addr.address_line2 or \"\" }}<br>\n            {{ addr.city or \"\" }}<br>\n            {{ addr.pincode or \"\" }}<br>\n            {{ addr.country or \"\" }}\n\n            {% set addr_ar = [addr.get(\"custom_address_line1_arabic\"), addr.get(\"custom_area_arabic\"), addr.get(\"custom_city_arabic\")] | select | list %}\n            {% if addr_ar %}\n                <br><span dir=\"rtl\">{{ addr_ar | join(\"، \") }}</span>\n            {% endif %}\n\n        {% endif %}\n\n    </td>\n\n\n    <!-- =====================================================\n         RIGHT SIDE - QUOTATION DETAILS\n    ====================================================== -->\n\n    <td style=\"\n        width:45%;\n        vertical-align:top;\n        padding:5px;\n        text-align:right;\n        padding-right:40px;\n    \">\n\n        <table style=\"width:100%;border:none;margin:0;text-align:left;\"><tr><td style=\"border:none;padding:1px 4px !important;white-space:nowrap;\"><strong>Quotation No</strong></td><td style=\"border:none;padding:1px 4px !important;\">{{ doc.name }}</td><td style=\"border:none;padding:1px 4px !important;text-align:right;white-space:nowrap;\"><span style=\"direction:rtl;\"><strong>رقم العرض</strong></span></td></tr><tr><td style=\"border:none;padding:1px 4px !important;white-space:nowrap;\"><strong>Date</strong></td><td style=\"border:none;padding:1px 4px !important;\">{{ frappe.utils.formatdate(doc.transaction_date) }}</td><td style=\"border:none;padding:1px 4px !important;text-align:right;white-space:nowrap;\"><span style=\"direction:rtl;\"><strong>التاريخ</strong></span></td></tr><tr><td style=\"border:none;padding:1px 4px !important;white-space:nowrap;\"><strong>Customer ID</strong></td><td style=\"border:none;padding:1px 4px !important;\">{{ customer_id or '' }}</td><td style=\"border:none;padding:1px 4px !important;text-align:right;white-space:nowrap;\"><span style=\"direction:rtl;\"><strong>رقم العميل</strong></span></td></tr>{% if doc.custom_project %}<tr><td style=\"border:none;padding:1px 4px !important;white-space:nowrap;\"><strong>Project</strong></td><td style=\"border:none;padding:1px 4px !important;\">{{ frappe.db.get_value(\"Project\", doc.custom_project, \"project_name\") or doc.custom_project }}</td><td style=\"border:none;padding:1px 4px !important;text-align:right;white-space:nowrap;\"><span style=\"direction:rtl;\"><strong>المشروع</strong></span></td></tr>{% endif %}</table>\n\n    </td>\n\n</tr>\n\n</table>\n\n\n<!-- =========================================================\n     INTRODUCTION\n========================================================= -->\n\n<p>Dear sir</p>\n\n<p>\n    Thank You very much to inviting us to providing this quotation\n    for the following items.Please find our offer as follow:\n</p>\n\n\n<!-- =========================================================\n     ITEMS TABLE\n========================================================= -->\n\n<table class=\"detail\"\n       style=\"\n           width:100%;\n           border-collapse:collapse;\n       \">\n\n<thead>\n\n<tr>\n\n    <!-- SL NO -->\n\n    <th class=\"col-no\"\n        style=\"\n            padding:3px !important;\n            text-align:center;\n        \">\n\n        رقم<br>SL No.\n\n    </th>\n\n\n    <!-- ITEM CODE -->\n\n    <th class=\"col-code\"\n        style=\"\n            padding:3px !important;\n            text-align:center;\n        \">\n\n        رمز الصنف<br>Item Code\n\n    </th>\n\n\n    <!-- DESCRIPTION -->\n\n    <th class=\"col-desc\"\n        style=\"\n            padding:3px !important;\n            text-align:center;\n        \">\n\n        الوصف<br>Description\n\n    </th>\n\n\n    <!-- UNIT -->\n\n    <th class=\"col-unit\"\n        style=\"\n            padding:3px !important;\n            text-align:center;\n        \">\n\n        الوحدة<br>Unit\n\n    </th>\n\n\n    <!-- QTY -->\n\n    <th class=\"col-qty\"\n        style=\"\n            padding:3px !important;\n            text-align:center;\n        \">\n\n        الكمية<br>Qty\n\n    </th>\n\n\n    <!-- RATE -->\n\n    <th class=\"col-price\"\n        style=\"\n            padding:3px !important;\n            text-align:center;\n        \">\n\n        السعر<br>Rate\n\n    </th>\n\n\n    <!-- SUB TOTAL -->\n\n    <th class=\"col-subtotal\"\n        style=\"\n            padding:3px !important;\n            text-align:center;\n        \">\n\n        المجموع الفرعي<br>Sub Total\n\n    </th>\n\n\n    <!-- VAT -->\n\n    <th class=\"col-vat\"\n        style=\"\n            padding:3px !important;\n            text-align:center;\n        \">\n\n        الضريبة<br>VAT\n\n    </th>\n\n\n    <!-- TOTAL -->\n\n    <th class=\"col-total\"\n        style=\"\n            padding:3px !important;\n            text-align:center;\n        \">\n\n        الإجمالي<br>Total\n\n    </th>\n\n</tr>\n\n</thead>\n\n\n<tbody>\n\n{% for item in doc.items %}\n\n    {% set currency = item.currency or doc.currency %}\n\n    <tr>\n\n\n        <!-- SL NO -->\n\n        <td style=\"\n            padding:5px !important;\n            text-align:center;\n        \">\n\n            {{ item.idx }}\n\n        </td>\n\n\n        <!-- ITEM CODE -->\n\n        <td style=\"\n            text-align:start;\n            padding:5px !important;\n        \">\n\n            {{ item.item_code }}\n\n        </td>\n\n\n        <!-- DESCRIPTION -->\n\n        <td style=\"\n            text-align:start;\n            padding:5px !important;\n        \">\n\n            {{ item.description }}\n\n        </td>\n\n\n        <!-- UNIT -->\n\n        <td style=\"\n            padding:5px !important;\n            text-align:center;\n        \">\n\n            {{ item.uom }}\n\n        </td>\n\n\n        <!-- QTY -->\n\n        <td style=\"\n            padding:5px !important;\n            text-align:center;\n        \">\n\n            {{ item.qty|int }}\n\n        </td>\n\n\n        <!-- RATE -->\n\n        <td style=\"\n            padding:5px !important;\n            text-align:right;\n        \">\n\n            {% if currency == \"SAR\" %}\n\n                <span class=\"icon-saudi_riyal\"></span>\n\n                <span>\n                    {{ frappe.utils.fmt_money(\n                        item.rate,\n                        currency=\"\",\n                        precision=2\n                    ) }}\n                </span>\n\n            {% else %}\n\n                <span>\n                    {{ frappe.utils.fmt_money(\n                        item.rate,\n                        currency=currency,\n                        precision=2\n                    ) }}\n                </span>\n\n            {% endif %}\n\n        </td>\n\n\n        <!-- SUB TOTAL -->\n\n        <td style=\"\n            padding:5px !important;\n            text-align:right;\n        \">\n\n            {% if currency == \"SAR\" %}\n\n                <span class=\"icon-saudi_riyal\"></span>\n\n                <span>\n                    {{ frappe.utils.fmt_money(\n                        item.amount,\n                        currency=\"\",\n                        precision=2\n                    ) }}\n                </span>\n\n            {% else %}\n\n                <span>\n                    {{ frappe.utils.fmt_money(\n                        item.amount,\n                        currency=currency,\n                        precision=2\n                    ) }}\n                </span>\n\n            {% endif %}\n\n        </td>\n\n\n        <!-- VAT -->\n\n        <td style=\"\n            padding:5px !important;\n            text-align:right;\n        \">\n\n            {% if currency == \"SAR\" %}\n\n                <span class=\"icon-saudi_riyal\"></span>\n\n                <span>\n                    {{ frappe.utils.fmt_money(\n                        item.amount * 0.15,\n                        currency=\"\",\n                        precision=2\n                    ) }}\n                </span>\n\n            {% else %}\n\n                <span>\n                    {{ frappe.utils.fmt_money(\n                        item.amount * 0.15,\n                        currency=currency,\n                        precision=2\n                    ) }}\n                </span>\n\n            {% endif %}\n\n        </td>\n\n\n        <!-- TOTAL -->\n\n        <td style=\"\n            padding:5px !important;\n            text-align:right;\n        \">\n\n            {% if currency == \"SAR\" %}\n\n                <span class=\"icon-saudi_riyal\"></span>\n\n                <span>\n                    {{ frappe.utils.fmt_money(\n                        item.amount * 1.15,\n                        currency=\"\",\n                        precision=2\n                    ) }}\n                </span>\n\n            {% else %}\n\n                <span>\n                    {{ frappe.utils.fmt_money(\n                        item.amount * 1.15,\n                        currency=currency,\n                        precision=2\n                    ) }}\n                </span>\n\n            {% endif %}\n\n        </td>\n\n    </tr>\n\n{% endfor %}\n\n</tbody>\n\n</table>\n\n\n<!-- =========================================================\n     TOTALS SECTION\n========================================================= -->\n\n<div class=\"total-box\">\n\n\n    <!-- SUB TOTAL -->\n\n    <div class=\"total-row total-subtotal\">\n\n        <div>\n            Sub Total / <span dir=\"rtl\">المجموع الفرعي</span>\n        </div>\n\n        <div class=\"text-right\">\n\n            {% if doc.currency == \"SAR\" %}\n\n                <span class=\"icon-saudi_riyal\"></span>\n\n                {{ frappe.utils.fmt_money(\n                    doc.total,\n                    currency=\"\",\n                    precision=2\n                ) }}\n\n            {% else %}\n\n                {{ frappe.utils.fmt_money(\n                    doc.total,\n                    currency=doc.currency,\n                    precision=2\n                ) }}\n\n            {% endif %}\n\n        </div>\n\n    </div>\n\n\n    <!-- VAT -->\n\n    <div class=\"total-row total-vat\">\n\n        <div>\n            VAT 15% / <span dir=\"rtl\">ضريبة القيمة المضافة</span>\n        </div>\n\n        <div class=\"text-right\">\n\n            {% if doc.currency == \"SAR\" %}\n\n                <span class=\"icon-saudi_riyal\"></span>\n\n                {{ frappe.utils.fmt_money(\n                    doc.total_taxes_and_charges,\n                    currency=\"\",\n                    precision=2\n                ) }}\n\n            {% else %}\n\n                {{ frappe.utils.fmt_money(\n                    doc.total_taxes_and_charges,\n                    currency=doc.currency,\n                    precision=2\n                ) }}\n\n            {% endif %}\n\n        </div>\n\n    </div>\n\n\n    <!-- GRAND TOTAL -->\n\n    <div class=\"total-row total-grand\">\n\n        <div>\n            Grand Total / <span dir=\"rtl\">الإجمالي الكلي</span>\n        </div>\n\n        <div class=\"text-right\">\n\n            {% if doc.currency == \"SAR\" %}\n\n                <span class=\"icon-saudi_riyal\"></span>\n\n                {{ frappe.utils.fmt_money(\n                    doc.grand_total,\n                    currency=\"\",\n                    precision=2\n                ) }}\n\n            {% else %}\n\n                {{ frappe.utils.fmt_money(\n                    doc.grand_total,\n                    currency=doc.currency,\n                    precision=2\n                ) }}\n\n            {% endif %}\n\n        </div>\n\n    </div>\n\n\n    <!-- GRAND TOTAL IN WORDS -->\n\n    <div class=\"total-row total-words\">\n\n        <div>\n            Grand Total in Words / <span dir=\"rtl\">الإجمالي كتابةً</span>\n        </div>\n\n        <div class=\"text-right\">\n            {{ doc.in_words }}\n        </div>\n\n    </div>\n\n</div>\n\n\n<!-- =========================================================\n     TERMS & CONDITIONS\n========================================================= -->\n\n<table style=\"\n    width:100%;\n    border-collapse:collapse;\n    font-size:13px;\n    font-family:Arial, Helvetica, sans-serif;\n    margin-top:15px;\n    table-layout:fixed;\n\">\n\n    <tr>\n\n        <td style=\"\n            border:1px solid #000;\n            padding:6px;\n            font-weight:bold;\n            text-decoration:underline;\n        \">\n\n            TERMS & CONDITIONS / <span dir=\"rtl\">الشروط والأحكام</span>\n\n        </td>\n\n    </tr>\n\n\n    <tr>\n\n        <td style=\"\n            border:1px solid #000;\n            padding:8px;\n            line-height:1.6;\n        \">\n\n            {{ doc.terms or '' }}\n\n        </td>\n\n    </tr>\n\n</table>\n\n\n<!-- =========================================================\n     CLOSING\n========================================================= -->\n\n<p>\n    We will be happy to supply any further information you may need\n    and trust that you call on us to fill your order,which will receive\n    our prompt and carefull attention.\n</p>\n\n<p>Best Regards,</p>\n\n<br>\n\n\n<!-- =========================================================\n     BANK DETAILS\n========================================================= -->\n\n{% if doc.company == \"Rukn Al Mashreq International Trading Company\" %}\n\n<div style=\"\n    display:flex;\n    justify-content:space-between;\n    align-items:center;\n    font-size:12px;\n\">\n\n\n    <!-- LEFT BANK -->\n\n    <div style=\"\n        display:flex;\n        align-items:center;\n        gap:8px;\n        margin-left:10px;\n    \">\n\n        <span>\n            SA1210000025300000185504\n        </span>\n\n        <img src=\"/files/SNB_BANK-removebg-preview.png\"\n             style=\"height:20px;\">\n\n    </div>\n\n\n    <!-- RIGHT BANK -->\n\n    <div style=\"\n        display:flex;\n        align-items:center;\n        gap:8px;\n    \">\n\n        <span>\n            SA8930400108095579540010\n        </span>\n\n        <img src=\"/files/ANB_BANK-removebg-preview.png\"\n             style=\"height:20px;\">\n\n    </div>\n\n</div>\n\n\n{% elif doc.company == \"ABB\" %}\n\n<div style=\"\n    display:flex;\n    justify-content:flex-start;\n    align-items:center;\n    font-size:12px;\n\">\n\n    <div style=\"\n        display:flex;\n        align-items:center;\n        gap:8px;\n        margin-left:10px;\n    \">\n\n        <span>\n            SA7180000390608017654110\n        </span>\n\n        <img src=\"/files/Gemini_Generated_Image_by555dby555dby55-removebg-preview.png\"\n             style=\"height:20px;\">\n\n    </div>\n\n</div>\n\n{% endif %}\n\n\n                </div>\n\n            </td>\n\n        </tr>\n\n    </tbody>\n\n\n    <!-- =====================================================\n         FOOTER SPACE\n    ====================================================== -->\n\n    <tfoot>\n\n        <tr>\n\n            <td style=\"\n                padding:0 !important;\n                border:none;\n            \">\n\n                <div class=\"footer-space\">&nbsp;</div>\n\n            </td>\n\n        </tr>\n\n    </tfoot>\n\n</table>\n\n\n<!-- =========================================================\n     COMPANY FOOTER\n========================================================= -->\n\n{% if doc.company == \"Rukn Al Mashreq International Trading Company\" %}\n\n<div style=\"\n    position:fixed;\n    bottom:0;\n    left:0;\n    right:0;\n\">\n\n    <img src=\"/files/footer RAM.png\"\n         style=\"\n             width:100%;\n             height:auto;\n             object-fit:cover;\n         \">\n\n</div>\n\n\n{% elif doc.company == \"ABB\" %}\n\n<div style=\"\n    position:fixed;\n    bottom:0;\n    left:0;\n    right:0;\n\">\n\n    <img src=\"/files/FOOTER ABB.png\"\n         style=\"\n             width:100%;\n             object-fit:contain;\n         \">\n\n</div>\n\n\n{% elif doc.company == \"JCB\" %}\n\n<div style=\"\n    position:fixed;\n    bottom:0;\n    left:0;\n    right:0;\n\">\n\n    <img src=\"/files/footerjcb1.png\"\n         style=\"\n             width:100%;\n             object-fit:contain;\n         \">\n\n</div>\n\n\n{% elif doc.company == \"Voltbuilds\" %}\n\n<div style=\"\n    position:fixed;\n 